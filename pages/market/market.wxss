.search-wrap { padding: 16rpx 24rpx; background: #fff; }
.search-input {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  background: #F1F5F9;
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  display: block;
}
.tab-scroll { white-space: nowrap; background: #fff; padding: 12rpx 24rpx 16rpx; border-bottom: 1rpx solid #F1F5F9; }
.tab-item { display: inline-block; padding: 10rpx 24rpx; margin-right: 12rpx; font-size: 26rpx; color: #64748B; border-radius: 32rpx; background: #F1F5F9; }
.tab-item.active { background: #EFF6FF; color: #1A56DB; font-weight: bold; }
.list-title { font-size: 30rpx; font-weight: 500; line-height: 1.4; color: #1E293B; }
.list-sub { font-size: 24rpx; color: #94A3B8; display: block; margin: 8rpx 0; line-height: 1.4; }
.list-intro { font-size: 26rpx; color: #64748B; display: block; line-height: 1.5; }
.list-wrap { width: 100%; box-sizing: border-box; }
.list-card { width: auto; box-sizing: border-box; }
