<view class="container page-with-tabbar">
  <!-- 数据概览 -->
  <view class="stats-card card">
    <view class="stats-row">
      <view class="stat-item" bindtap="goPublish">
        <text class="stat-num">{{stats.publish}}</text>
        <text class="stat-label">我的发布</text>
      </view>
      <view class="stat-item" bindtap="goTool" data-url="/pages/messages/messages">
        <text class="stat-num">{{stats.message}}</text>
        <text class="stat-label">未读消息</text>
      </view>
      <view class="stat-item" bindtap="goTool" data-url="/pages/favorites/favorites">
        <text class="stat-num">{{stats.favorite}}</text>
        <text class="stat-label">我的收藏</text>
      </view>
    </view>
    <text class="member-tip">{{membership.active ? membership.planName + ' · 有效期至 ' + membership.expireDate : '开通会员解锁联系方式与发布权限'}}</text>
  </view>

  <!-- 工具入口 -->
  <view class="card">
    <text class="section-title">常用工具</text>
    <view class="tool-grid">
      <view class="tool-item" wx:for="{{tools}}" wx:key="name" bindtap="goTool" data-url="{{item.url}}">
        <text class="tool-icon">{{item.icon}}</text>
        <text class="tool-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 最近发布 -->
  <view class="card">
    <view class="flex-between">
      <text class="section-title" style="margin:0">最近发布</text>
      <text class="more-link" bindtap="goPublish">全部 ></text>
    </view>
    <view class="recent-item" wx:for="{{recentPublish}}" wx:key="id">
      <view class="recent-title ellipsis">{{item.title}}</view>
      <text class="recent-meta">{{item.time}} · {{item.status === 'pending' ? '审核中' : '已发布'}}</text>
    </view>
    <view class="empty-hint" wx:if="{{recentPublish.length === 0}}">
      <text>暂无发布，点击底部 + 快速发布</text>
    </view>
  </view>
</view>
