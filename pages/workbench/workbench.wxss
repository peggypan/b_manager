.page-with-tabbar { padding-bottom: calc(130rpx + env(safe-area-inset-bottom)); }

.stats-card { background: linear-gradient(135deg, #EFF6FF, #DBEAFE); }
.stats-row { display: flex; margin-bottom: 16rpx; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: bold; color: #1A56DB; display: block; }
.stat-label { font-size: 24rpx; color: #64748B; }
.member-tip { font-size: 22rpx; color: #475569; text-align: center; display: block; }

.tool-grid { display: flex; flex-wrap: wrap; }
.tool-item { width: 33.33%; display: flex; flex-direction: column; align-items: center; padding: 24rpx 0; }
.tool-icon { font-size: 44rpx; margin-bottom: 8rpx; }
.tool-name { font-size: 24rpx; color: #475569; }

.more-link { font-size: 24rpx; color: #94A3B8; }
.recent-item { padding: 16rpx 0; border-bottom: 1rpx solid #F1F5F9; }
.recent-item:last-child { border-bottom: none; }
.recent-title { font-size: 28rpx; display: block; line-height: 1.4; color: #1E293B; }
.recent-meta { font-size: 22rpx; color: #94A3B8; }
.empty-hint { text-align: center; padding: 32rpx 0; font-size: 26rpx; color: #CBD5E1; }
