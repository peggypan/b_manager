<view class="container">
  <view class="card form-group">
    <view class="form-item"><text class="form-label">{{typeName}}标题 *</text><input placeholder="请输入标题" bindinput="onInput" data-field="title" /></view>
    <view class="form-item"><text class="form-label">详细描述 *</text><textarea placeholder="请详细描述发布内容" bindinput="onInput" data-field="intro" /></view>
    <view class="form-item"><text class="form-label">联系人 *</text><input placeholder="联系人姓名" bindinput="onInput" data-field="contact" /></view>
    <view class="form-item"><text class="form-label">联系电话 *</text><input type="number" placeholder="手机号或座机" bindinput="onInput" data-field="phone" /></view>
    <view class="form-item"><text class="form-label">微信号 *</text><input placeholder="用于对接的微信号" bindinput="onInput" data-field="wechat" /></view>
  </view>

  <view class="card">
    <text class="section-title">图文视频（选填）</text>
    <media-upload max-images="{{6}}" image-label="上传图片" video-label="上传视频" bind:change="onMediaChange" />
  </view>

  <view class="submit-wrap"><button class="btn-primary" bindtap="submit">发布</button></view>
</view>
