.filter-bar { background: #fff; padding: 12rpx 0; border-bottom: 1rpx solid #F1F5F9; }
.filter-scroll { white-space: nowrap; padding: 8rpx 24rpx; }
.filter-label { font-size: 24rpx; color: #94A3B8; margin-right: 12rpx; }
.filter-item { display: inline-block; padding: 6rpx 20rpx; margin-right: 8rpx; font-size: 24rpx; color: #64748B; border-radius: 24rpx; background: #F1F5F9; }
.filter-item.active { background: #EFF6FF; color: #1A56DB; }
.card-title { font-size: 32rpx; font-weight: bold; display: block; margin-bottom: 12rpx; }
.card-meta { font-size: 24rpx; color: #94A3B8; display: block; margin: 8rpx 0; }
.card-intro { font-size: 26rpx; color: #64748B; }
.card-biz { margin-top: 12rpx; }
.biz-tag { display: inline-block; padding: 4rpx 12rpx; background: #F1F5F9; color: #475569; font-size: 22rpx; border-radius: 6rpx; margin-right: 8rpx; }
.fab {
  position: fixed; right: 32rpx; bottom: 120rpx;
  background: #1A56DB; color: #fff; padding: 20rpx 32rpx;
  border-radius: 44rpx; font-size: 28rpx; box-shadow: 0 4rpx 16rpx rgba(26,86,219,0.4);
}
