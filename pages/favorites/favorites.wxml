<view class="container">
  <view class="fav-item card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-url="{{item.url}}">
    <text class="fav-title">{{item.title}}</text>
    <text class="tag tag-gray">{{item.type}}</text>
  </view>
  <view class="empty-state" wx:if="{{list.length === 0}}">
    <text class="empty-icon">⭐</text><text>暂无收藏</text>
  </view>
</view>
