.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f4f8;
  box-sizing: border-box;
}

.chat-header {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  flex-shrink: 0;
}

.chat-peer {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.chat-sub {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
  display: block;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.chat-tip {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 8rpx 48rpx 24rpx;
}

.bubble-row {
  display: flex;
  padding: 8rpx 24rpx;
}

.bubble-row.mine {
  justify-content: flex-end;
}

.bubble-row.peer {
  justify-content: flex-start;
}

.bubble {
  max-width: 72%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.mine .bubble {
  background: linear-gradient(135deg, #1a56db, #3b82f6);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.55;
  color: #1e293b;
  word-break: break-word;
  display: block;
}

.mine .bubble-text {
  color: #fff;
}

.bubble-time {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.mine .bubble-time {
  color: rgba(255, 255, 255, 0.75);
  text-align: right;
}

.scroll-tail {
  height: 24rpx;
}

.chat-bar {
  flex-shrink: 0;
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
  padding-bottom: env(safe-area-inset-bottom);
}

.chat-input-row {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  gap: 12rpx;
}

.chat-input {
  flex: 1;
  background: #f1f5f9;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.send-btn {
  padding: 12rpx 28rpx;
  background: #1a56db;
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}
