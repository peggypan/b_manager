page {
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

.container {
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
  box-sizing: border-box;
}

.community-header {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  background: #fff;
}

.search-input {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  background: #F1F5F9;
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  color: #1E293B;
  display: block;
}

.tab-scroll {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-bottom: 1rpx solid #F1F5F9;
  white-space: nowrap;
}

.tab-inner {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.tab-item {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  line-height: 56rpx;
  color: #64748B;
  border-radius: 32rpx;
  background: #F1F5F9;
  box-sizing: border-box;
}

.tab-item:last-child { margin-right: 0; }
.tab-item.active { background: #EFF6FF; color: #1A56DB; font-weight: bold; }

.waterfall {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 24rpx 0;
  gap: 16rpx;
  align-items: flex-start;
}

.waterfall-col {
  flex: 1;
  width: 0;
  min-width: 0;
  max-width: calc(50% - 8rpx);
}

.note-card {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.note-cover {
  width: 100%;
  max-width: 100%;
  display: block;
  background: #F1F5F9;
  vertical-align: top;
}

.video-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 22rpx;
  line-height: 1.3;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.note-body {
  padding: 16rpx;
  box-sizing: border-box;
}

.note-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1E293B;
  line-height: 1.45;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.note-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  width: 100%;
  min-width: 0;
}

.note-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.note-author {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.4;
}

.note-likes {
  font-size: 24rpx;
  color: #64748B;
  flex-shrink: 0;
  margin-left: 8rpx;
  line-height: 1.4;
}

.fab-publish {
  position: fixed;
  right: 24rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  background: linear-gradient(135deg, #1A56DB, #3B82F6);
  color: #fff;
  border-radius: 48rpx;
  min-height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(26, 86, 219, 0.35);
  z-index: 10;
  max-width: calc(100vw - 48rpx);
  box-sizing: border-box;
}

.fab-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
}

.fab-icon {
  font-size: 30rpx;
  line-height: 1;
  margin-right: 10rpx;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 2rpx;
}

.fab-text {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
  height: 40rpx;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
}
