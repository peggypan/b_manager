.detail-name { font-size: 36rpx; font-weight: bold; color: #1E293B; display: block; }
.detail-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.demand-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: #ECFEFF;
  color: #0891B2;
}
.demand-tag.category { background: #EFF6FF; color: #1A56DB; }
.demand-tag.dropship { background: #ECFDF5; color: #059669; }
.detail-meta { font-size: 24rpx; color: #94A3B8; display: block; margin-bottom: 12rpx; }
.detail-intro { font-size: 28rpx; color: #64748B; line-height: 1.6; }
.info-row {
  display: flex;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #334155;
  border-bottom: 1rpx solid #F1F5F9;
}
.info-row:last-child { border-bottom: none; }
.info-label { width: 160rpx; color: #94A3B8; flex-shrink: 0; }
.media-scroll { white-space: nowrap; margin-top: 12rpx; }
.media-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; margin-right: 16rpx; display: inline-block; }
.match-tip {
  display: block;
  font-size: 24rpx;
  color: #94A3B8;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #F8FAFC;
  border-radius: 8rpx;
}
.contact-lock { text-align: center; padding: 24rpx 0; }
.lock-icon { font-size: 48rpx; display: block; }
.lock-text { font-size: 26rpx; color: #94A3B8; display: block; margin: 12rpx 0 20rpx; }
