<view class="container">
  <view class="tab-bar">
    <text class="tab-item {{activeTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" bindtap="switchTab" data-index="{{index}}">{{item}}</text>
  </view>

  <!-- 投资项目 -->
  <block wx:if="{{activeTab === 0}}">
    <view class="card list-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <text class="card-title">{{item.name}}</text>
      <view class="card-tags">
        <text class="tag tag-gold">{{item.track}}</text>
        <text class="tag tag-blue">{{item.stage}}</text>
      </view>
      <text class="card-need">{{item.need}}</text>
      <view class="card-intro ellipsis-2">{{item.intro}}</view>
    </view>
    <view class="fab" bindtap="goPublish">+ 发布项目</view>
  </block>

  <!-- 推广服务 -->
  <block wx:if="{{activeTab === 1}}">
    <view class="service-card card" wx:for="{{services}}" wx:key="id" bindtap="goBook" data-id="{{item.id}}">
      <image class="service-img" src="{{item.image}}" mode="aspectFill" />
      <view class="service-info">
        <text class="service-name">{{item.name}}</text>
        <text class="service-desc">{{item.desc}}</text>
        <view class="flex-between">
          <text class="service-price">{{item.price}}</text>
          <text class="book-link">预约咨询 ></text>
        </view>
        <text class="service-cases">案例：{{item.cases}}</text>
      </view>
    </view>
  </block>

  <!-- 达人合作 -->
  <block wx:if="{{activeTab === 2}}">
    <view class="influencer-tip card">
      <text>抖音 / 快手 / 小红书宠物达人，品牌分销带货与坑位合作</text>
    </view>
    <scroll-view scroll-x class="platform-scroll">
      <text class="platform-item {{activePlatform === index ? 'active' : ''}}" wx:for="{{platforms}}" wx:key="*this" bindtap="filterPlatform" data-index="{{index}}">{{item}}</text>
    </scroll-view>
    <view class="influencer-card card" wx:for="{{influencers}}" wx:key="id" bindtap="goInfluencerDetail" data-id="{{item.id}}">
      <view class="flex-between">
        <text class="influencer-name">{{item.name}}</text>
        <text class="tag tag-blue">{{item.platform}}</text>
      </view>
      <text class="influencer-meta">粉丝 {{item.fans}} · {{item.category}}</text>
      <text class="influencer-mode">合作模式：{{item.mode}}</text>
      <view class="influencer-intro ellipsis">{{item.intro}}</view>
      <text class="influencer-cases">案例：{{item.cases}}</text>
    </view>
    <view class="fab fab-influencer" bindtap="goInfluencerPublish">+ 达人入驻</view>
  </block>
</view>
