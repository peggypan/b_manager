<view class="container">
  <view class="quota-card card">
    <view class="flex-between">
      <text class="quota-title">我的发布</text>
      <text class="quota-num">{{publishUsed}} / {{publishLimit < 0 ? '不限' : publishLimit}}</text>
    </view>
    <text class="quota-tip">统一管理社区帖子、找工厂、找订单、门店货源/求购、宠业展厅、宠业创投、免费入驻等，支持编辑、下架、删除</text>
  </view>

  <scroll-view scroll-x class="tab-scroll">
    <view class="tab-item {{activeTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" bindtap="switchTab" data-index="{{index}}">{{item}}</view>
  </scroll-view>

  <view class="publish-list">
    <view class="publish-item card" wx:for="{{publishList}}" wx:key="{{item.type}}-{{item.id}}">
      <text class="publish-item-title">{{item.title}}</text>
      <text class="publish-item-time">{{item.typeLabel}} · {{item.time}} · {{item.statusText}}</text>
      <view class="publish-actions">
        <text
          class="action-btn"
          wx:if="{{item.canEdit}}"
          catchtap="editItem"
          data-id="{{item.id}}"
          data-type="{{item.type}}"
        >编辑</text>
        <text
          class="action-btn warn"
          wx:if="{{item.canOffline}}"
          catchtap="offlineItem"
          data-id="{{item.id}}"
          data-type="{{item.type}}"
        >下架</text>
        <text
          class="action-btn danger"
          catchtap="removeItem"
          data-id="{{item.id}}"
          data-type="{{item.type}}"
        >删除</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{publishList.length === 0}}">
      <text class="empty-icon">📝</text>
      <text>该分类暂无发布内容</text>
    </view>
  </view>
</view>
