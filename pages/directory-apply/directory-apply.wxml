<view class="container">
  <view class="tip-card card">
    <text>免费入驻企业黄页，审核通过后展示企业名片。联系方式需开通会员后对其他企业可见。</text>
  </view>
  <view class="card form-group">
    <view class="form-item"><text class="form-label">企业名称 *</text><input placeholder="请输入企业全称" bindinput="onInput" data-field="name" /></view>
    <view class="form-item">
      <text class="form-label">主体类型 *</text>
      <picker range="{{types}}" bindchange="selectType"><view class="picker">{{form.type || '请选择'}} ></view></picker>
    </view>
    <view class="form-item"><text class="form-label">主营品类</text><input placeholder="如：主粮、用品" bindinput="onInput" data-field="category" /></view>
    <view class="form-item"><text class="form-label">所在地区</text><input placeholder="如：广东广州" bindinput="onInput" data-field="region" /></view>
    <view class="form-item"><text class="form-label">企业简介</text><textarea placeholder="介绍企业优势和主营业务" bindinput="onInput" data-field="intro" /></view>
    <view class="form-item"><text class="form-label">主营产品/服务</text><input placeholder="如：OEM代工、品牌代理" bindinput="onInput" data-field="products" /></view>
    <view class="form-item"><text class="form-label">联系人 *</text><input placeholder="联系人姓名" bindinput="onInput" data-field="contact" /></view>
    <view class="form-item"><text class="form-label">联系电话</text><input type="number" placeholder="联系电话" bindinput="onInput" data-field="phone" /></view>
  </view>

  <view class="card media-card">
    <text class="section-title">企业展示（选填）</text>
    <media-upload max-images="{{6}}" image-label="上传企业图片" video-label="上传企业视频" bind:change="onMediaChange" />
  </view>

  <view class="submit-wrap"><button class="btn-primary" bindtap="submit">提交入驻申请</button></view>
</view>
