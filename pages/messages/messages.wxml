<view class="container">
  <view class="tab-bar">
    <text class="tab-item {{activeTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" bindtap="switchTab" data-index="{{index}}">{{item}}</text>
  </view>

  <view class="msg-list">
    <view class="msg-item card {{!item.read ? 'unread' : ''}}" wx:for="{{messages}}" wx:key="id">
      <view class="flex-between">
        <text class="msg-from">{{item.from}}</text>
        <text class="msg-time">{{item.time}}</text>
      </view>
      <text class="msg-content">{{item.content}}</text>
    </view>
  </view>

  <view class="compose-panel card" wx:if="{{showCompose}}">
    <text class="section-title">发送留言</text>
    <input placeholder="对方企业/项目名称" bindinput="onComposeInput" data-field="target" />
    <textarea placeholder="请输入留言内容（免费用户可留言沟通）" bindinput="onComposeInput" data-field="content" />
    <button class="btn-primary" bindtap="sendMessage">发送</button>
  </view>
</view>
