.tab-bar { display: flex; background: #fff; padding: 16rpx 24rpx; }
.tab-item { flex: 1; text-align: center; font-size: 26rpx; color: #64748B; padding: 12rpx 0; }
.tab-item.active { color: #1A56DB; font-weight: bold; border-bottom: 4rpx solid #1A56DB; }
.msg-item.unread { border-left: 6rpx solid #1A56DB; }
.msg-from { font-size: 28rpx; font-weight: 500; }
.msg-time { font-size: 22rpx; color: #94A3B8; }
.msg-content { font-size: 26rpx; color: #64748B; display: block; margin-top: 8rpx; }
.compose-panel input, .compose-panel textarea { background: #F1F5F9; border-radius: 12rpx; padding: 16rpx; margin: 12rpx 0; font-size: 28rpx; width: 100%; box-sizing: border-box; }
.compose-panel textarea { height: 200rpx; }
