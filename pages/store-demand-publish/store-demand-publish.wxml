<view class="container">
  <view class="tip-card card">
    <text class="tip-title">🏪 宠物店老板发布求购</text>
    <text class="tip-text">发布求购需求，工厂看到后主动联系。可上传样品参考图/视频，平台仅撮合不对接交易。</text>
  </view>

  <view class="card form-group">
    <view class="form-item">
      <text class="form-label">门店名称 *</text>
      <input placeholder="您的宠物店名称" bindinput="onInput" data-field="storeName" />
    </view>
    <view class="form-item">
      <text class="form-label">求购标题 *</text>
      <input placeholder="如：求平价猫砂一件代发" bindinput="onInput" data-field="title" />
    </view>
    <view class="form-item">
      <text class="form-label">需求品类</text>
      <picker range="{{categories}}" bindchange="selectCategory">
        <view class="picker">{{form.category || '请选择'}} ></view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">需求描述 *</text>
      <textarea placeholder="详细描述规格、价格区间、代发要求等" bindinput="onInput" data-field="intro" />
    </view>
    <view class="form-item">
      <text class="form-label">联系人 *</text>
      <input placeholder="联系人姓名" bindinput="onInput" data-field="contact" />
    </view>
    <view class="form-item">
      <text class="form-label">联系电话 *</text>
      <input type="number" placeholder="手机号或座机" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-item">
      <text class="form-label">微信号 *</text>
      <input placeholder="用于工厂联系的微信号" bindinput="onInput" data-field="wechat" />
    </view>
  </view>

  <view class="card">
    <text class="section-title">样品参考（选填）</text>
    <media-upload max-images="{{3}}" image-label="上传参考图" video-label="上传参考视频" bind:change="onMediaChange" />
  </view>

  <view class="submit-wrap">
    <button class="btn-primary" bindtap="submit">发布求购</button>
  </view>
</view>
