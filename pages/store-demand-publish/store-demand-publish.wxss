.tip-card { background: linear-gradient(135deg, #EFF6FF, #DBEAFE); }
.tip-title { font-size: 30rpx; font-weight: bold; color: #1E40AF; display: block; }
.tip-text { font-size: 24rpx; color: #3B82F6; line-height: 1.5; display: block; margin-top: 8rpx; }
.form-item { padding: 20rpx 0; border-bottom: 1rpx solid #F1F5F9; }
.form-label { font-size: 28rpx; color: #64748B; display: block; margin-bottom: 12rpx; }
.form-item input, .form-item textarea { font-size: 30rpx; width: 100%; }
.form-item textarea { height: 180rpx; }
.picker { font-size: 30rpx; padding: 8rpx 0; }
.submit-wrap { padding: 40rpx 48rpx 60rpx; }
