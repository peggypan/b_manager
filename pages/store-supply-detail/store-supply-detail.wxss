.cover-section { position: relative; background: #000; }
.cover-img, .cover-video { width: 100%; height: 500rpx; }
.play-btn {
  position: absolute; bottom: 24rpx; left: 50%; transform: translateX(-50%);
  background: rgba(0,0,0,0.6); color: #fff; padding: 12rpx 32rpx; border-radius: 32rpx; font-size: 26rpx;
}
.detail-name { font-size: 34rpx; font-weight: bold; display: block; margin-bottom: 12rpx; }
.detail-tags { margin-bottom: 12rpx; }
.supply-tag {
  display: inline-block; padding: 4rpx 12rpx; margin-right: 8rpx;
  font-size: 22rpx; background: #E0F2FE; color: #0284C7; border-radius: 6rpx;
}
.supply-tag.stock { background: #DCFCE7; color: #16A34A; }
.price-row { margin-bottom: 12rpx; }
.moq-text { font-size: 26rpx; color: #94A3B8; }
.detail-intro { font-size: 28rpx; color: #64748B; line-height: 1.6; }
.info-row { display: flex; padding: 12rpx 0; border-bottom: 1rpx solid #F8FAFC; font-size: 28rpx; }
.info-label { width: 160rpx; color: #94A3B8; flex-shrink: 0; }
.media-scroll { white-space: nowrap; }
.media-img { display: inline-block; width: 200rpx; height: 200rpx; border-radius: 12rpx; margin-right: 12rpx; }
.section-sub { font-size: 26rpx; color: #64748B; display: block; margin: 16rpx 0 8rpx; }
.workshop-player { width: 100%; height: 360rpx; border-radius: 12rpx; }
.factory-name { font-size: 30rpx; font-weight: bold; display: block; }
.factory-region { font-size: 24rpx; color: #94A3B8; }
.factory-link { font-size: 26rpx; color: #1A56DB; }
.match-tip { font-size: 24rpx; color: #F59E0B; display: block; margin-bottom: 16rpx; line-height: 1.5; }
