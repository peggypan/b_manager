.search-wrap { padding: 16rpx 24rpx; background: #fff; }
.search-input { background: #F1F5F9; border-radius: 32rpx; padding: 16rpx 24rpx; font-size: 28rpx; }
.tab-scroll { white-space: nowrap; background: #fff; padding: 12rpx 24rpx 16rpx; }
.tab-item {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #64748B;
  border-radius: 24rpx;
  background: #F1F5F9;
  line-height: 1.4;
  vertical-align: middle;
}
.tab-item.active { background: #FFFBEB; color: #D97706; font-weight: bold; }
.company-card { display: flex; padding: 20rpx; }
.company-img { width: 160rpx; height: 120rpx; border-radius: 12rpx; margin-right: 16rpx; }
.company-name { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.company-meta { font-size: 24rpx; color: #94A3B8; display: block; margin: 8rpx 0; }
.company-intro { font-size: 26rpx; color: #64748B; display: block; line-height: 1.5; }
.fab { position: fixed; right: 32rpx; bottom: 120rpx; background: #F59E0B; color: #fff; padding: 20rpx 32rpx; border-radius: 44rpx; font-size: 28rpx; }
