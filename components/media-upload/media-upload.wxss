.media-upload {
  width: 100%;
}

.media-section {
  width: 100%;
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.media-section:first-child { margin-top: 0; }

.media-label {
  width: 100%;
  font-size: 26rpx;
  color: #64748B;
  display: block;
  margin-bottom: 16rpx;
  text-align: center;
  line-height: 1.4;
}

.image-grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.preview-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #F1F5F9;
}

.preview-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.upload-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F8FAFF;
  border: 2rpx dashed #BFDBFE;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #64748B;
  text-align: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.upload-add.video-add {
  width: 100%;
  height: 240rpx;
}

.upload-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
  line-height: 1;
}

.video-preview-wrap {
  position: relative;
  width: 100%;
}

.preview-video {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #000;
}

.video-del { top: 8rpx; right: 8rpx; }
