.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: flex-end;
  box-shadow: 0 -2rpx 20rpx rgba(26, 86, 219, 0.08);
  z-index: 9999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 12rpx;
  height: 110rpx;
}

.tab-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tab-icon-img {
  width: 48rpx;
  height: 48rpx;
  display: block;
  opacity: 0.72;
  transition: opacity 0.2s, transform 0.2s;
}
.tab-icon-img.active {
  opacity: 1;
  transform: scale(1.06);
}
.tab-text { font-size: 22rpx; color: #94A3B8; line-height: 1.2; display: block; max-width: 100%; overflow: visible; }
.tab-item.active .tab-text { color: #1A56DB; font-weight: bold; }

.center-item {
  position: relative;
  justify-content: flex-end;
  align-items: center;
  padding-bottom: 0;
  overflow: visible;
}

.center-btn {
  width: 96rpx;
  height: 96rpx;
  min-width: 96rpx;
  min-height: 96rpx;
  max-width: 96rpx;
  max-height: 96rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  background: linear-gradient(145deg, #3B82F6, #1A56DB);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(26, 86, 219, 0.35);
  border: 5rpx solid #fff;
}

.plus-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.plus-bar {
  position: absolute;
  left: 50%;
  top: 50%;
  background: #fff;
  border-radius: 3rpx;
  transform: translate(-50%, -50%);
}

.plus-h { width: 36rpx; height: 6rpx; }
.plus-v { width: 6rpx; height: 36rpx; }

/* 发布弹层 */
.publish-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 9998;
  pointer-events: none;
  transition: background 0.25s;
}

.publish-mask.show {
  background: rgba(15, 23, 42, 0.5);
  pointer-events: auto;
}

.publish-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.08);
  transform: translateY(100%);
  opacity: 0;
  transition: all 0.28s ease;
  max-height: 78vh;
  box-sizing: border-box;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

.publish-mask.show .publish-panel {
  transform: translateY(0);
  opacity: 1;
}

.panel-handle {
  width: 64rpx;
  height: 8rpx;
  background: #E2E8F0;
  border-radius: 4rpx;
  margin: 16rpx auto 8rpx;
}

.publish-scroll {
  max-height: calc(78vh - 110rpx - env(safe-area-inset-bottom));
  padding: 0 24rpx 16rpx;
  box-sizing: border-box;
}

.section-label {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #1E293B;
  margin: 16rpx 0 20rpx;
  line-height: 1.4;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.quick-card {
  position: relative;
  width: calc(50% - 10rpx);
  min-height: 148rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.quick-card-wide {
  width: 100%;
  min-height: 136rpx;
}

.quick-card-text {
  flex: 1;
  min-width: 0;
  z-index: 2;
  max-width: 72%;
}

.quick-card-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #1E293B;
  line-height: 1.35;
}

.quick-card-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.4;
  white-space: nowrap;
}

.quick-card-art {
  position: absolute;
  right: 8rpx;
  bottom: 4rpx;
  font-size: 72rpx;
  line-height: 1;
  z-index: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.08));
}

.quick-card-wide .quick-card-art {
  font-size: 80rpx;
  right: 24rpx;
  bottom: 8rpx;
}

/* 参照参考图 · 马卡龙渐变 */
.theme-green { background: linear-gradient(135deg, #ECFCCB 0%, #D9F99D 100%); }
.theme-blue { background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%); }
.theme-purple { background: linear-gradient(135deg, #EDE9FE 0%, #DDD6FE 100%); }
.theme-orange { background: linear-gradient(135deg, #FFEDD5 0%, #FED7AA 100%); }
.theme-yellow { background: linear-gradient(135deg, #FEF9C3 0%, #FDE047 100%); }
.theme-mint { background: linear-gradient(135deg, #D1FAE5 0%, #6EE7B7 100%); }

.publish-footer {
  text-align: center;
  padding: 24rpx 0 12rpx;
  font-size: 28rpx;
  color: #64748B;
  line-height: 1.4;
  border-top: 1rpx solid #F1F5F9;
  margin-top: 8rpx;
}
